# From Supabase dashboard -> Project Settings -> API (or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public base URL, used for customer quote/invoice links and auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only service role key (Supabase -> Settings -> API -> secret key). Used for public portal file links and webhooks.
SUPABASE_SECRET_KEY=
# Optional providers (features degrade gracefully when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
ANTHROPIC_API_KEY=
