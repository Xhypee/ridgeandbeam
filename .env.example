# From Supabase dashboard -> Project Settings -> API (or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Public base URL, used for customer quote/invoice links and auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only service role key (Supabase -> Settings -> API -> secret key). Used for public portal file links and webhooks.
SUPABASE_SECRET_KEY=
# Optional providers (features degrade gracefully when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Xero (developer.xero.com -> My Apps)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
XERO_SCOPES=
ANTHROPIC_API_KEY=
# Where "Report a change" on Settings -> State rules sends
NEXT_PUBLIC_RULES_REPORT_EMAIL=
